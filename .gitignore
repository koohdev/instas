# ── Dependencies ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build outputs ─────────────────────────────────────────────────────────────
/.next/
/out/
/build
/dist

# ── Test coverage ─────────────────────────────────────────────────────────────
/coverage

# ── TypeScript cache ──────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── App data (runtime-generated, not source) ──────────────────────────────────
/data/
/fonts/
/images/
/public/backgrounds/

# ── Generated carousel outputs ────────────────────────────────────────────────
/outputs/

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Debug logs ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Editor configs ────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/

# ── Vercel / deploy platform ──────────────────────────────────────────────────
.vercel

# ── MCP / agent meta (machine-local) ─────────────────────────────────────────
.mcp.json
